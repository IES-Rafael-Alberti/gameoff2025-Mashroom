; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Curse of the waves"
run/main_scene="uid://wt4d5ycbn3af"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/image="uid://ddg81l5wp8gij"
config/icon="uid://20fp21ngqhwu"

[autoload]

Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
AudioPlayer="*res://Scenes/AudioPlayer.tscn"

[dialogic]

directories/dch_directory={
"character_eris": "res://DialogicAssets/characters/eris/character_eris.dch",
"character_eris_hidden": "res://DialogicAssets/characters/eris/character_eris_hidden.dch",
"character_kumi": "res://DialogicAssets/characters/kumi/character_kumi.dch",
"character_minion1": "res://DialogicAssets/characters/minions/character_minion1.dch",
"character_minion2": "res://DialogicAssets/characters/minions/character_minion2.dch",
"character_zach": "res://DialogicAssets/characters/zach/character_zach.dch",
"character_zach_human": "res://DialogicAssets/characters/zach/character_zach_human.dch"
}
directories/dtl_directory={
"1-prologue": "res://DialogicAssets/timelines/1-prologue.dtl",
"2-underwater_scene": "res://DialogicAssets/timelines/2-underwater_scene.dtl",
"3-cave_scene": "res://DialogicAssets/timelines/3-cave_scene.dtl"
}
layout/style_directory={
"": "res://DialogicAssets/styles/Base.tres",
"BASE_BIG": "res://DialogicAssets/styles/BASE_BIG.tres",
"Base": "res://DialogicAssets/styles/Base.tres",
"Base_Dialogo": "res://DialogicAssets/styles/Base_Dialogo.tres",
"Kumi_style": "res://DialogicAssets/styles/Kumi_style.tres",
"New_File": "res://DialogicAssets/styles/New_File.tres"
}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.0
animations/join_default_wait=true
animations/leave_default_length=0.0
animations/leave_default_wait=true
animations/cross_fade_default_length=0.0
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
translation/enabled=true
translation/original_locale="en"
translation/file_mode=1
translation/translation_folder="res://DialogicAssets/translations"
translation/save_mode=0
translation/add_separator=false
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "SFX",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "Musica",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
glossary/default_case_sensitive=true
layout/style_list=["res://DialogicAssets/styles/Base.tres", "res://DialogicAssets/styles/BASE_BIG.tres", "res://DialogicAssets/styles/Base_Dialogo.tres", "res://DialogicAssets/styles/Kumi_style.tres", "res://DialogicAssets/styles/New_File.tres"]
layout/default_style="res://DialogicAssets/styles/Base.tres"
variables={
"canon_final": false,
"has_weapon": false
}
translation/locales=["en", "es"]
translation/id_counter=66
portraits/default_portrait=""
translation/intern/save_mode=0
translation/intern/file_mode=1
translation/intern/translation_folder="res://DialogicAssets/translations"
glossary/glossary_files=[]
history/simple_history_enabled=true
history/visited_event_history_enabled=true
text/autocolor_names=true
text/autoadvance_enabled=true
text/autoadvance_fixed_delay=0.01
animations/join_default="Instant In"
animations/leave_default="Instant Out"
text/input_action="MainAction"
choices/hotkey_behaviour=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/sdf/oversize=1

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[global_group]

Damage=""
SoundWave=""

